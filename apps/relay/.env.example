# URL pública del relay (en Google registrás el redirect <PUBLIC_URL>/_mono/auth/callback)
PUBLIC_URL=https://mono.155-181-39-178.sslip.io
# openssl rand -hex 32. Si lo rotás, se cierran todas las sesiones y se desconectan todas las Macs
SESSION_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admins: entran siempre y pueden invitar gente desde /_mono/admin
ADMIN_EMAILS=
# Base SQLite con usuarios e invitaciones
DB_PATH=./data/relay.db
# Solo para probar en local sin Google (se ignora si PUBLIC_URL es https)
# DEV_LOGIN=1
