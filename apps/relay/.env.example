# URL pública del relay (la misma que registrás en Google como redirect: <PUBLIC_URL>/_mono/auth/callback)
PUBLIC_URL=https://mono-relay.fly.dev
# openssl rand -hex 32 — rotarlo desconecta todas las Macs y cierra todas las sesiones
SESSION_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails de Google que pueden entrar y conectar máquinas
ALLOWED_EMAILS=
# Solo para probar en local sin Google (se ignora si PUBLIC_URL es https)
# DEV_LOGIN_EMAIL=yo@example.com
