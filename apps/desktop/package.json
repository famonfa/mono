{
  "name": "@mono/desktop",
  "productName": "Mono",
  "private": true,
  "version": "0.4.8",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage-server.mjs",
    "package": "npm run stage && electron-builder --mac --dir",
    "dist": "npm run stage && electron-builder --mac --dir --arm64 --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.famonfa.mono",
    "productName": "Mono",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "artifactName": "Mono-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "electronVersion": "45.0.0",
    "extraResources": [
      {
        "from": "server-bundle",
        "to": "server"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "description": "Mono desktop app",
  "author": "Facundo Monsegur"
}
