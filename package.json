{
  "name": "mono-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @famonfa/mono",
    "dev": "npm run dev -w @mono/web",
    "build": "npm run build -w @mono/web",
    "typecheck": "npm run typecheck -w @mono/web",
    "desktop": "npm run build && npm run start -w @mono/desktop",
    "desktop:package": "npm run build && npm run package -w @mono/desktop",
    "relay": "npm run start -w @mono/relay",
    "mobile:ios": "npm run ios -w @mono/mobile",
    "mobile:android": "npm run android -w @mono/mobile"
  }
}
